# 复制本文件为 .env 后填入真实值。.env 已 gitignore,不会入库。

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8084
# CORS origins:必须用 JSON 数组写,pydantic-settings 对复杂类型不接受逗号串
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Database ---
# 默认形态(api 容器走 host.docker.internal 连宿主机已有 Postgres):
#   推荐为本项目新建账号:CREATE ROLE achievements WITH LOGIN PASSWORD '...';
#                       CREATE DATABASE achievements OWNER achievements;
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@host.docker.internal:5432/achievements
#
# 完整形态(`docker compose --profile full up`,使用内置容器):
# DATABASE_URL=postgresql+asyncpg://achievements:achievements@db:5432/achievements
#
# Supabase 形态(免费托管 Postgres):
# - 推荐用 Transaction Pooler(端口 6543),并发友好,但要打开下方 DATABASE_DISABLE_STATEMENT_CACHE
# - 也可用 Session Pooler / 直连(端口 5432),无此限制但连接数更少
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_DISABLE_STATEMENT_CACHE=true
#
# 数据库保活间隔(小时):周期性 SELECT 1,防 Supabase free tier 闲置 ~7 天自动暂停。
# 自托管数据库可设 0 禁用。
DB_KEEPALIVE_INTERVAL_HOURS=6

# --- Redis ---
REDIS_URL=redis://host.docker.internal:6379/0
# 完整形态:
# REDIS_URL=redis://redis:6379/0

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/attachments

# --- Auth (身份收口到 SCC 软件控制中心;dev 默认关闭走单用户占位) ---
AUTH_ENABLED=false
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
# SCC 可达地址(后端代理公众号扫码登录用),部署时回填真实地址
SCC_BASE_URL=https://scc.example.com
# 在 SCC 后台注册 Achievements 应用得到的 app_id
SCC_APP_ID=0
# SCC 的 JWT_SECRET_KEY,安全渠道同步,仅用于离线验签 client token(勿入库/勿进日志)
SCC_JWT_SECRET=change-me-shared-with-scc
SCC_JWT_ALG=HS256
SCC_TIMEOUT_SECONDS=8
