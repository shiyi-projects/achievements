# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Database (asyncpg DSN) ---
DATABASE_URL=postgresql+asyncpg://achievements:achievements@db:5432/achievements

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/attachments

# --- Auth (placeholder for Phase 0; real JWT secret set later) ---
AUTH_ENABLED=false
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
