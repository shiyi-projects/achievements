# 生产环境变量样例。部署时复制为 .env.prod 并填入真实值,切勿入库。

APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=https://your-domain.example

# Postgres / Redis 使用 compose 内网 service 名,密码必须改强
DATABASE_URL=postgresql+asyncpg://achievements:CHANGE_ME@db:5432/achievements
REDIS_URL=redis://redis:6379/0

# Postgres 容器初始化变量(prod 同样需要传给 db 服务,可在 compose 中通过 environment 注入)
POSTGRES_DB=achievements
POSTGRES_USER=achievements
POSTGRES_PASSWORD=CHANGE_ME

# Storage:Phase 0 用本地磁盘,后续切 OSS 时改 STORAGE_BACKEND=oss 并填入桶/密钥
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage/attachments

# Auth(启用时填入随机长串)
AUTH_ENABLED=true
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
