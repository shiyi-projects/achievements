# 生产环境变量样例(宝塔 + Supabase)。部署时复制为 .env.prod 并填入真实值,切勿入库。
#   cp .env.prod.example .env.prod

APP_ENV=production
APP_DEBUG=false
# 容器内监听地址/端口;实际由 docker-compose.baota.yml 把容器 8084 绑到宿主
# 127.0.0.1:8084,再由宝塔 Nginx 反代到域名。
APP_HOST=0.0.0.0
APP_PORT=8084
# 允许的前端来源,必须用 JSON 数组写(pydantic-settings 对 list 复杂类型不接受逗号串)
APP_CORS_ORIGINS=["https://your-domain.example"]

# --- 数据库:Supabase 托管 Postgres ---
# 推荐 Transaction Pooler(端口 6543):并发友好,但必须同时打开下方的语句缓存开关;
# 也可用 Session Pooler / 直连(端口 5432),无此限制但连接数更少。
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# 走 6543 Transaction Pooler 时设为 true;直连/Session Pooler 设为 false 性能更好。
DATABASE_DISABLE_STATEMENT_CACHE=true

# --- 存储:本地磁盘(容器内路径,compose 已挂载到宿主持久化目录)---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage/attachments

# --- 鉴权:生产必开;JWT_SECRET 必须替换为长随机串 ---
AUTH_ENABLED=true
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
OLIB_BASE_URL=https://olib.11xy.cn
OLIB_TIMEOUT_SECONDS=8
AUTH_PROFILE_CACHE_TTL_SECONDS=60

# 说明:多账号模式下不再需要 LOCAL_USER_ID(仅 AUTH_ENABLED=false 的本地单用户用);
#       Redis 代码暂未使用;Postgres 走 Supabase 故无需 POSTGRES_* 容器初始化变量。
